
name: Gerar JARVIS APK

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Preparar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Preparar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Extrair projeto
        run: |
          unzip JARVIS-Android-Projeto.zip
          
      - name: Compilar APK
        run: gradle -p JARVIS assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: JARVIS-APK
          path: JARVIS/app/build/outputs/apk/debug/app-debug.apk
